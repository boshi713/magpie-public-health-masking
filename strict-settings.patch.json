{
  "redact": true,
  "redactPersonal": true,
  "redactModel": true,
  "redactModelOff": false,
  "redactWordsAnyCase": true,
  "redactRules": [
    {
      "kind": "PH_PII",
      "regex": "(?i)(?:姓名|患者姓名|联系人|监护人|身份证号|证件号|护照号|电话|手机|联系方式|微信号|QQ号|账号|银行卡号|密码|口令|密钥|令牌)[\"'”’*]?[ \\t]*(?:[:：=]|\\|)[ \\t]*[\"'“‘]?([^\\r\\n\\t,，;；。|\"'“”‘’<>\\[\\]{}]{1,100})"
    },
    {
      "kind": "PH_PII",
      "regex": "(?:^|[^0-9])(1[3-9][0-9][ -]?[0-9]{4}[ -]?[0-9]{4})(?:$|[^0-9])"
    },
    {
      "kind": "PH_PII",
      "regex": "(?:^|[^0-9])(0[0-9]{2,3}[ -][0-9]{7,8}(?:[-转][0-9]{1,6})?)(?:$|[^0-9])"
    },
    {
      "kind": "PH_PII",
      "regex": "(?i)(?:^|[^0-9A-Za-z])([1-9][0-9]{16}[0-9X]|[1-9][0-9]{14})(?:$|[^0-9A-Za-z])"
    },
    {
      "kind": "PH_MED",
      "regex": "(?i)(?:报告卡号|病例编号|个案编号|传报卡号|病案号|住院号|门诊号|就诊卡号|医保号|标本号|样本号|疫情编号|事件编号|密接编号|监测点编号)[\"'”’*]?[ \\t]*(?:[:：=]|\\|)[ \\t]*[\"'“‘]?([^\\r\\n\\t,，;；。|\"'“”‘’<>\\[\\]{}]{1,100})"
    },
    {
      "kind": "PH_MED",
      "regex": "(?i)(?:送检编号|检验编号|检测编号|条码号|项目编号|任务编号|数据集编号|数据集名称|数据集名|样本编号)[\"'”’*]?[ \\t]*(?:[:：=]|\\|)[ \\t]*[\"'“‘]?([^\\r\\n\\t,，;；。|\"'“”‘’<>\\[\\]{}]{1,100})"
    },
    {
      "kind": "PH_PLACE",
      "regex": "(?i)(?:监测任务名称|监测任务名|项目名称|监测项目名称|课题名称|任务名称)[\"'”’*]?[ \\t]*(?:[:：=]|\\|)[ \\t]*[\"'“‘]?([^\\r\\n\\t,，;；。|\"'“”‘’<>\\[\\]{}]{1,100})"
    },
    {
      "kind": "PH_MED",
      "regex": "(?i)(?:case_id|report_id|patient_id|specimen_id|sample_id|project_id|dataset_name|dataset_id)[\"'”’*]?[ \\t]*(?:[:：=]|\\|)[ \\t]*[\"'“‘]?([^\\r\\n\\t,，;；。|\"'“”‘’<>\\[\\]{}]{1,100})"
    },
    {
      "kind": "PH_PLACE",
      "regex": "(?i)(?:现住址|户籍地址|家庭住址|详细地址|居住地|工作单位|就读学校|单位名称|学校名称|就诊医院|隔离点|报告单位|送检单位|检测机构|监测点)[\"'”’*]?[ \\t]*(?:[:：=]|\\|)[ \\t]*[\"'“‘]?([^\\r\\n\\t,，;；。|\"'“”‘’<>\\[\\]{}]{1,100})"
    },
    {
      "kind": "PH_PLACE",
      "regex": "(?i)(?:班级|宿舍|床位号|病房号|门牌号|房间号|座位号|车厢)[\"'”’*]?[ \\t]*(?:[:：=]|\\|)[ \\t]*[\"'“‘]?([^\\r\\n\\t,，;；。|\"'“”‘’<>\\[\\]{}]{1,100})"
    },
    {
      "kind": "PH_PLACE",
      "regex": "([\\p{Han}]{2,18}(?:省|市|县|区|镇|乡|街道|社区|村|小区)(?:[\\p{Han}A-Za-z0-9-]{0,32}(?:路|街|巷|号|栋|幢|单元|室))?)"
    },
    {
      "kind": "PH_PLACE",
      "regex": "([\\p{Han}A-Za-z0-9]{2,32}(?:医院|卫生院|卫生服务中心|疾控中心|小学|中学|幼儿园|大学|有限公司|酒店|农贸市场))"
    },
    {
      "kind": "PH_PLACE",
      "regex": "([A-Za-z0-9一二三四五六七八九十]{1,8}(?:号楼|栋|幢|单元|号房|室|年级|班))"
    },
    {
      "kind": "PH_PLACE",
      "regex": "([京津沪渝冀豫云辽黑湘皖鲁新苏浙赣鄂桂甘晋蒙陕吉闽贵粤青藏川宁琼][A-Z][A-Z0-9]{5,6})"
    },
    {
      "kind": "PH_PLACE",
      "regex": "([-+]?[0-9]{1,3}\\.[0-9]{4,}[,，][ \\t]*[-+]?[0-9]{1,3}\\.[0-9]{4,})"
    },
    {
      "kind": "PH_NET",
      "regex": "(?i)((?:https?://)[^\\s<>\"，；。]+|(?:[0-9]{1,3}\\.){3}[0-9]{1,3})"
    },
    {
      "kind": "PH_TIME",
      "regex": "((?:19|20)[0-9]{2}[-/.年][0-9]{1,2}[-/.月][0-9]{1,2}日?)"
    },
    {
      "kind": "PH_TIME",
      "regex": "([0-9]{1,2}月[0-9]{1,2}[日号])"
    },
    {
      "kind": "PH_TIME",
      "regex": "([0-2]?[0-9][:：][0-5][0-9](?:[:：][0-5][0-9])?|[0-2]?[0-9]时[0-5]?[0-9]分)"
    },
    {
      "kind": "PH_DEMO",
      "regex": "(?i)(?:年龄|出生日期|出生年月|生日|籍贯|民族|职业|职务)[\"'”’*]?[ \\t]*(?:[:：=]|\\|)[ \\t]*[\"'“‘]?([^\\r\\n\\t,，;；。|\"'“”‘’<>\\[\\]{}]{1,100})"
    },
    {
      "kind": "PH_DEMO",
      "regex": "([0-9]{1,3}(?:周岁|岁|月龄|日龄))"
    },
    {
      "kind": "PH_DX",
      "regex": "(鼠疫|霍乱|传染性非典型肺炎|人感染高致病性禽流感|人感染H7N9禽流感|流行性出血热|流行性乙型脑炎|流行性脑脊髓膜炎|新生儿破伤风|布鲁氏菌病|钩端螺旋体病|感染性腹泻病|急性出血性结膜炎|流行性腮腺炎|基孔肯雅热)"
    },
    {
      "kind": "PH_DX",
      "regex": "(艾滋病|病毒性肝炎|脊髓灰质炎|狂犬病|登革热|炭疽|细菌性痢疾|阿米巴性痢疾|肺结核|副伤寒|伤寒|百日咳|白喉|猩红热|淋病|梅毒|血吸虫病|疟疾|发热伴血小板减少综合征)"
    },
    {
      "kind": "PH_DX",
      "regex": "(猴痘|人感染H7N9禽流感|禽流感|新冠病毒感染|新冠肺炎|新冠|禽流感|流行性感冒|流感|风疹|麻风病|斑疹伤寒|黑热病|包虫病|丝虫病|手足口病)"
    }
  ]
}
