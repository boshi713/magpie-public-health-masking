{
  "redact": true,
  "redactPersonal": true,
  "redactModel": true,
  "redactModelOff": false,
  "redactWordsAnyCase": true,
  "redactRules": [
    {
      "kind": "PH_NAME",
      "regex": "(?i)(?:姓名|患者姓名|联系人|监护人|调查员|签名|patient_name|full_name)[\"'”’]?[ \\t]*[:：=][ \\t]*[\"'“‘]?([^\\r\\n\\t,，;；。|\"'“”‘’<>\\[\\]{}]{1,100})"
    },
    {
      "kind": "PH_ID",
      "regex": "(?i)(?:身份证号?|证件号|护照号|通行证号|id_number|passport)[\"'”’]?[ \\t]*[:：=][ \\t]*[\"'“‘]?([^\\r\\n\\t,，;；。|\"'“”‘’<>\\[\\]{}]{1,100})"
    },
    {
      "kind": "PH_CONTACT",
      "regex": "(?i)(?:电话|手机|联系方式|微信号?|QQ号?|contact|phone)[\"'”’]?[ \\t]*[:：=][ \\t]*[\"'“‘]?([^\\r\\n\\t,，;；。|\"'“”‘’<>\\[\\]{}]{1,100})"
    },
    {
      "kind": "PH_CASE",
      "regex": "(?i)(?:报告卡号|病例编号|个案编号|传报卡号|case_id|report_id)[\"'”’]?[ \\t]*[:：=][ \\t]*[\"'“‘]?([^\\r\\n\\t,，;；。|\"'“”‘’<>\\[\\]{}]{1,100})"
    },
    {
      "kind": "PH_MEDICAL",
      "regex": "(?i)(?:病案号|住院号|门诊号|就诊卡号|医保号|patient_id|medical_record)[\"'”’]?[ \\t]*[:：=][ \\t]*[\"'“‘]?([^\\r\\n\\t,，;；。|\"'“”‘’<>\\[\\]{}]{1,100})"
    },
    {
      "kind": "PH_SAMPLE",
      "regex": "(?i)(?:标本号|样本号|送检编号|检验编号|条码号|sample_id|specimen_id)[\"'”’]?[ \\t]*[:：=][ \\t]*[\"'“‘]?([^\\r\\n\\t,，;；。|\"'“”‘’<>\\[\\]{}]{1,100})"
    },
    {
      "kind": "PH_ADDRESS",
      "regex": "(?i)(?:现住址|户籍地址|家庭住址|详细地址|居住地|地址|address)[\"'”’]?[ \\t]*[:：=][ \\t]*[\"'“‘]?([^\\r\\n\\t,，;；。|\"'“”‘’<>\\[\\]{}]{1,100})"
    },
    {
      "kind": "PH_ORG",
      "regex": "(?i)(?:工作单位|就读学校|单位名称|学校名称|就诊医院|隔离点|employer)[\"'”’]?[ \\t]*[:：=][ \\t]*[\"'“‘]?([^\\r\\n\\t,，;；。|\"'“”‘’<>\\[\\]{}]{1,100})"
    },
    {
      "kind": "PH_ROOM",
      "regex": "(?i)(?:班级|宿舍|床位号?|病房号?|门牌号|房间号|座位号)[\"'”’]?[ \\t]*[:：=][ \\t]*[\"'“‘]?([^\\r\\n\\t,，;；。|\"'“”‘’<>\\[\\]{}]{1,100})"
    },
    {
      "kind": "PH_TRANSPORT",
      "regex": "(?i)(?:车牌号?|航班号?|车次|船名|座号|flight_no)[\"'”’]?[ \\t]*[:：=][ \\t]*[\"'“‘]?([^\\r\\n\\t,，;；。|\"'“”‘’<>\\[\\]{}]{1,100})"
    },
    {
      "kind": "PH_COORD",
      "regex": "(?i)(?:经度|纬度|坐标|longitude|latitude|gps)[\"'”’]?[ \\t]*[:：=][ \\t]*[\"'“‘]?([^\\r\\n\\t,，;；。|\"'“”‘’<>\\[\\]{}]{1,100})"
    },
    {
      "kind": "PH_ACCOUNT",
      "regex": "(?i)(?:账号|账户|银行卡号|银行账号|account_no)[\"'”’]?[ \\t]*[:：=][ \\t]*[\"'“‘]?([^\\r\\n\\t,，;；。|\"'“”‘’<>\\[\\]{}]{1,100})"
    },
    {
      "kind": "PH_SECRET",
      "regex": "(?i)(?:密码|口令|密钥|令牌|访问凭证)[\"'”’]?[ \\t]*[:：=][ \\t]*[\"'“‘]?([^\\r\\n\\t,，;；。|\"'“”‘’<>\\[\\]{}]{1,100})"
    },
    {
      "kind": "PH_DEMOGRAPHIC",
      "regex": "(?i)(?:年龄|出生日期|生日|民族|职业|职务|age|occupation)[\"'”’]?[ \\t]*[:：=][ \\t]*[\"'“‘]?([^\\r\\n\\t,，;；。|\"'“”‘’<>\\[\\]{}]{1,100})"
    },
    {
      "kind": "PH_EVENT",
      "regex": "(?i)(?:疫情编号|事件编号|聚集性疫情编号|密接编号|contact_id)[\"'”’]?[ \\t]*[:：=][ \\t]*[\"'“‘]?([^\\r\\n\\t,，;；。|\"'“”‘’<>\\[\\]{}]{1,100})"
    },
    {
      "kind": "PH_MOBILE",
      "regex": "(?:^|[^0-9])(1[3-9][0-9][ -]?[0-9]{4}[ -]?[0-9]{4})(?:$|[^0-9])"
    },
    {
      "kind": "PH_LANDLINE",
      "regex": "(?:^|[^0-9])(0[0-9]{2,3}[ -][0-9]{7,8}(?:[-转][0-9]{1,6})?)(?:$|[^0-9])"
    },
    {
      "kind": "PH_ID_SHAPE",
      "regex": "(?i)(?:^|[^0-9A-Za-z])([1-9][0-9]{16}[0-9X]|[1-9][0-9]{14})(?:$|[^0-9A-Za-z])"
    },
    {
      "kind": "PH_DATE",
      "regex": "((?:19|20)[0-9]{2}[-/.年][0-9]{1,2}[-/.月][0-9]{1,2}日?)"
    },
    {
      "kind": "PH_MONTHDAY",
      "regex": "([0-9]{1,2}月[0-9]{1,2}[日号])"
    },
    {
      "kind": "PH_TIME",
      "regex": "([0-2]?[0-9][:：][0-5][0-9](?:[:：][0-5][0-9])?|[0-2]?[0-9]时[0-5]?[0-9]分)"
    },
    {
      "kind": "PH_AGE_TEXT",
      "regex": "([0-9]{1,3}(?:周岁|岁|月龄|日龄))"
    },
    {
      "kind": "PH_LOCATION_TEXT",
      "regex": "([\\p{Han}]{2,18}(?:省|市|县|区|镇|乡|街道|社区|村|小区)(?:[\\p{Han}A-Za-z0-9-]{0,32}(?:路|街|巷|号|栋|幢|单元|室))?)"
    },
    {
      "kind": "PH_ORG_TEXT",
      "regex": "([\\p{Han}A-Za-z0-9]{2,32}(?:医院|卫生院|卫生服务中心|小学|中学|幼儿园|大学|有限公司|酒店|农贸市场))"
    },
    {
      "kind": "PH_ROOM_TEXT",
      "regex": "([A-Za-z0-9一二三四五六七八九十]{1,8}(?:号楼|栋|幢|单元|号房|室|年级|班))"
    },
    {
      "kind": "PH_PLATE",
      "regex": "([京津沪渝冀豫云辽黑湘皖鲁新苏浙赣鄂桂甘晋蒙陕吉闽贵粤青藏川宁琼][A-Z][A-Z0-9]{5,6})"
    },
    {
      "kind": "PH_NETWORK",
      "regex": "(?i)((?:https?://)[^\\s<>\"，；。]+|(?:[0-9]{1,3}\\.){3}[0-9]{1,3})"
    },
    {
      "kind": "PH_COORD_PAIR",
      "regex": "([-+]?[0-9]{1,3}\\.[0-9]{4,}[,，][ \\t]*[-+]?[0-9]{1,3}\\.[0-9]{4,})"
    }
  ]
}
